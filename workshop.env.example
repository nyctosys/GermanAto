# Copy to .env next to docker-compose.yml. Never commit .env.
DB_PASSWORD=change-me-to-a-long-random-password
TIMEZONE=Asia/Karachi
# true only when the site is served over HTTPS
COOKIE_SECURE=false

# WhatsApp (leave empty to keep messages queued)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
PUBLIC_URL=

# Cloud sync (leave empty until the cloud server exists)
SYNC_CLOUD_URL=
SYNC_TOKEN=
SYNC_INTERVAL_SECONDS=60
